{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steelcore.local/schemas/provenance/artifact-provenance.schema.json",
  "title": "Steelcore Artifact Provenance Record",
  "description": "Schema version 0.2 is additive within the 0.x provenance contract only when new fields are optional or permit explicit unknown states. Producers and PR #5 importers must write the exact supported schema_version and must not infer unknown legacy facts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "artifact_version", "artifact_type", "title", "created_at", "classification", "human_contributors", "ai_systems", "source_inputs", "transformations", "rights", "disclosure", "approvals", "release_clearance", "release"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.2"},
    "artifact_id": {"$ref": "#/$defs/non_empty_string"},
    "artifact_version": {"$ref": "#/$defs/non_empty_string"},
    "artifact_type": {"type": "string", "enum": ["lyrics", "composition", "audio", "image", "video", "persona", "prompt", "document", "mixed"]},
    "title": {"$ref": "#/$defs/non_empty_string"},
    "created_at": {"$ref": "#/$defs/known_or_unknown_timestamp"},
    "classification": {"$ref": "#/$defs/artifact_classification"},
    "human_contributors": {"type": "array", "items": {"$ref": "#/$defs/human_contributor"}},
    "ai_systems": {"type": "array", "items": {"$ref": "#/$defs/ai_system"}},
    "source_inputs": {"type": "array", "items": {"$ref": "#/$defs/source_input"}},
    "transformations": {"type": "array", "items": {"$ref": "#/$defs/transformation"}},
    "rights": {"$ref": "#/$defs/rights_assessment"},
    "disclosure": {"$ref": "#/$defs/disclosure_assessment"},
    "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval_record"}},
    "release_clearance": {"$ref": "#/$defs/release_clearance"},
    "release": {"$ref": "#/$defs/release_status"}
  },
  "allOf": [
    {"if": {"properties": {"classification": {"const": "canon"}}, "required": ["classification"]}, "then": {"properties": {"approvals": {"contains": {"type": "object", "required": ["approval_type", "status", "reviewer", "timestamp", "evidence_refs"], "properties": {"approval_type": {"const": "canon"}, "status": {"const": "approved"}, "reviewer": {"$ref": "#/$defs/known_string"}, "timestamp": {"$ref": "#/$defs/timestamp"}, "evidence_refs": {"$ref": "#/$defs/non_empty_evidence_refs"}}}}}}},
    {"if": {"properties": {"release_clearance": {"properties": {"status": {"const": "cleared"}}, "required": ["status"]}}, "required": ["release_clearance"]}, "then": {"properties": {"rights": {"properties": {"ownership_status": {"const": "cleared"}, "voice_likeness_status": {"enum": ["cleared", "not_applicable"]}, "cultural_review_status": {"enum": ["cleared", "not_applicable"]}}, "required": ["ownership_status", "voice_likeness_status", "cultural_review_status"]}, "release_clearance": {"required": ["reviewer", "timestamp", "evidence_refs"], "properties": {"reviewer": {"$ref": "#/$defs/known_string"}, "timestamp": {"$ref": "#/$defs/timestamp"}, "evidence_refs": {"$ref": "#/$defs/non_empty_evidence_refs"}}}, "approvals": {"contains": {"type": "object", "required": ["approval_type", "status", "reviewer", "timestamp", "evidence_refs"], "properties": {"approval_type": {"const": "release"}, "status": {"const": "approved"}, "reviewer": {"$ref": "#/$defs/known_string"}, "timestamp": {"$ref": "#/$defs/timestamp"}, "evidence_refs": {"$ref": "#/$defs/non_empty_evidence_refs"}}}}}}}
  ],
  "$defs": {
    "artifact_classification": {"type": "string", "enum": ["unresolved", "evidence", "experiment", "candidate", "canon"]},
    "status": {"type": "string", "enum": ["approved", "cleared", "documented", "pending", "rejected", "unresolved", "unknown", "not_applicable"]},
    "non_empty_string": {"type": "string", "minLength": 1},
    "known_string": {"type": "string", "minLength": 1, "not": {"const": "unknown"}},
    "timestamp": {"type": "string", "format": "date-time", "minLength": 20},
    "known_or_unknown_timestamp": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"const": "unknown"}]},
    "evidence_ref": {"$ref": "#/$defs/non_empty_string"},
    "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidence_ref"}},
    "non_empty_evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
    "human_contributor": {"type": "object", "additionalProperties": false, "required": ["name", "role", "contribution", "evidence_status", "evidence_refs"], "properties": {"name": {"oneOf": [{"$ref": "#/$defs/known_string"}, {"const": "unknown"}]}, "role": {"oneOf": [{"$ref": "#/$defs/known_string"}, {"const": "unknown"}]}, "contribution": {"$ref": "#/$defs/non_empty_string"}, "evidence_status": {"type": "string", "enum": ["documented", "self_attested", "unknown"]}, "evidence_refs": {"$ref": "#/$defs/evidence_refs"}}},
    "ai_system": {"type": "object", "additionalProperties": false, "required": ["provider", "product", "model_or_version", "plan", "used_for", "usage_date", "prompt_or_session_refs", "terms_snapshot_status", "terms_snapshot_ref"], "properties": {"provider": {"oneOf": [{"$ref": "#/$defs/known_string"}, {"const": "unknown"}]}, "product": {"oneOf": [{"$ref": "#/$defs/known_string"}, {"const": "unknown"}]}, "model_or_version": {"oneOf": [{"$ref": "#/$defs/known_string"}, {"const": "unknown"}]}, "plan": {"oneOf": [{"$ref": "#/$defs/known_string"}, {"const": "unknown"}]}, "used_for": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/non_empty_string"}}, "usage_date": {"$ref": "#/$defs/known_or_unknown_timestamp"}, "prompt_or_session_refs": {"$ref": "#/$defs/evidence_refs"}, "terms_snapshot_status": {"type": "string", "enum": ["captured", "pending", "unavailable", "unknown"]}, "terms_snapshot_ref": {"oneOf": [{"$ref": "#/$defs/evidence_ref"}, {"type": "null"}]}}},
    "source_input": {"type": "object", "additionalProperties": false, "required": ["source_id", "source_type", "description", "rights_status", "source_ref"], "properties": {"source_id": {"$ref": "#/$defs/non_empty_string"}, "source_type": {"$ref": "#/$defs/non_empty_string"}, "description": {"$ref": "#/$defs/non_empty_string"}, "rights_status": {"type": "string", "enum": ["owned", "licensed", "public_domain", "permission_pending", "unresolved", "unknown", "not_applicable"]}, "source_ref": {"oneOf": [{"$ref": "#/$defs/evidence_ref"}, {"type": "null"}]}}},
    "transformation": {"type": "object", "additionalProperties": false, "required": ["timestamp", "actor", "action", "input_version", "output_version", "evidence_refs"], "properties": {"timestamp": {"$ref": "#/$defs/known_or_unknown_timestamp"}, "actor": {"oneOf": [{"$ref": "#/$defs/known_string"}, {"const": "unknown"}]}, "action": {"$ref": "#/$defs/non_empty_string"}, "input_version": {"$ref": "#/$defs/non_empty_string"}, "output_version": {"$ref": "#/$defs/non_empty_string"}, "evidence_refs": {"$ref": "#/$defs/evidence_refs"}}},
    "rights_assessment": {"type": "object", "additionalProperties": false, "required": ["human_authorship_status", "ai_generated_material", "ownership_status", "ownership_evidence_refs", "voice_likeness_status", "voice_likeness_evidence_refs", "cultural_review_status", "cultural_review_evidence_refs", "limitations_or_exclusions"], "properties": {"human_authorship_status": {"type": "string", "enum": ["documented", "partial", "unknown", "none_claimed"]}, "ai_generated_material": {"type": "array", "items": {"type": "string"}}, "ownership_status": {"type": "string", "enum": ["cleared", "partially_cleared", "pending", "rejected", "unresolved", "unknown", "not_applicable"]}, "ownership_evidence_refs": {"$ref": "#/$defs/evidence_refs"}, "voice_likeness_status": {"type": "string", "enum": ["cleared", "pending", "rejected", "unresolved", "unknown", "not_applicable"]}, "voice_likeness_evidence_refs": {"$ref": "#/$defs/evidence_refs"}, "cultural_review_status": {"type": "string", "enum": ["cleared", "pending", "rejected", "unresolved", "unknown", "not_applicable"]}, "cultural_review_evidence_refs": {"$ref": "#/$defs/evidence_refs"}, "limitations_or_exclusions": {"type": "array", "items": {"type": "string"}}}, "allOf": [{"if": {"properties": {"ownership_status": {"const": "cleared"}}, "required": ["ownership_status"]}, "then": {"properties": {"ownership_evidence_refs": {"$ref": "#/$defs/non_empty_evidence_refs"}}}}, {"if": {"properties": {"voice_likeness_status": {"const": "cleared"}}, "then": {"properties": {"voice_likeness_evidence_refs": {"$ref": "#/$defs/non_empty_evidence_refs"}}}}}, {"if": {"properties": {"cultural_review_status": {"const": "cleared"}}, "then": {"properties": {"cultural_review_evidence_refs": {"$ref": "#/$defs/non_empty_evidence_refs"}}}}}]},
    "disclosure_assessment": {"type": "object", "additionalProperties": false, "required": ["ai_involvement_summary", "public_disclosure_status", "platform_metadata_status", "disclosure_ref"], "properties": {"ai_involvement_summary": {"$ref": "#/$defs/non_empty_string"}, "public_disclosure_status": {"type": "string", "enum": ["approved", "pending", "rejected", "unresolved", "unknown", "not_applicable"]}, "platform_metadata_status": {"type": "string", "enum": ["prepared", "submitted", "pending", "rejected", "unresolved", "unknown", "not_applicable"]}, "disclosure_ref": {"oneOf": [{"$ref": "#/$defs/evidence_ref"}, {"type": "null"}]}}},
    "approval_record": {"type": "object", "additionalProperties": false, "required": ["approval_type", "status", "reviewer", "timestamp", "evidence_refs", "notes"], "properties": {"approval_type": {"type": "string", "enum": ["canon", "legal", "cultural", "release", "publication", "production", "owner", "professional"]}, "status": {"type": "string", "enum": ["approved", "pending", "rejected", "unknown", "not_applicable"]}, "reviewer": {"oneOf": [{"$ref": "#/$defs/known_string"}, {"const": "unknown"}, {"type": "null"}]}, "timestamp": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"const": "unknown"}, {"type": "null"}]}, "evidence_refs": {"$ref": "#/$defs/evidence_refs"}, "notes": {"type": "string"}}, "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]}, "then": {"properties": {"reviewer": {"$ref": "#/$defs/known_string"}, "timestamp": {"$ref": "#/$defs/timestamp"}, "evidence_refs": {"$ref": "#/$defs/non_empty_evidence_refs"}}}},
    "release_clearance": {"type": "object", "additionalProperties": false, "required": ["status", "reviewer", "timestamp", "evidence_refs", "notes"], "properties": {"status": {"type": "string", "enum": ["cleared", "pending", "rejected", "unresolved", "unknown", "not_applicable"]}, "reviewer": {"oneOf": [{"$ref": "#/$defs/known_string"}, {"const": "unknown"}, {"type": "null"}]}, "timestamp": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"const": "unknown"}, {"type": "null"}]}, "evidence_refs": {"$ref": "#/$defs/evidence_refs"}, "notes": {"type": "string"}}},
    "release_status": {"type": "object", "additionalProperties": false, "required": ["status", "destinations", "release_date", "release_refs"], "properties": {"status": {"type": "string", "enum": ["unreleased", "scheduled", "released", "withdrawn", "blocked"]}, "destinations": {"type": "array", "items": {"type": "string"}}, "release_date": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}, "release_refs": {"$ref": "#/$defs/evidence_refs"}}}
  }
}
