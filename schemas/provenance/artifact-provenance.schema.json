{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steelcore.local/schemas/provenance/artifact-provenance.schema.json",
  "title": "Steelcore Artifact Provenance Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_version",
    "artifact_type",
    "title",
    "created_at",
    "classification",
    "human_contributors",
    "ai_systems",
    "source_inputs",
    "transformations",
    "rights",
    "disclosure",
    "approvals",
    "release"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_version": {"type": "string", "minLength": 1},
    "artifact_type": {
      "type": "string",
      "enum": ["lyrics", "composition", "audio", "image", "video", "persona", "prompt", "document", "mixed"]
    },
    "title": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "classification": {
      "type": "string",
      "enum": ["canon", "candidate", "experiment", "evidence", "unresolved"]
    },
    "human_contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "contribution", "evidence_status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "contribution": {"type": "string", "minLength": 1},
          "evidence_status": {"type": "string", "enum": ["documented", "self_attested", "unknown"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "default": []}
        }
      }
    },
    "ai_systems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "product", "model_or_version", "plan", "used_for", "usage_date", "terms_snapshot_status"],
        "properties": {
          "provider": {"type": "string", "minLength": 1},
          "product": {"type": "string", "minLength": 1},
          "model_or_version": {"type": "string", "minLength": 1},
          "plan": {"type": "string", "minLength": 1},
          "used_for": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "usage_date": {"type": "string", "format": "date-time"},
          "prompt_or_session_refs": {"type": "array", "items": {"type": "string"}, "default": []},
          "terms_snapshot_status": {"type": "string", "enum": ["captured", "pending", "unavailable"]},
          "terms_snapshot_ref": {"type": ["string", "null"]}
        }
      }
    },
    "source_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_type", "description", "rights_status"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_type": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "rights_status": {"type": "string", "enum": ["owned", "licensed", "public_domain", "permission_pending", "unknown"]},
          "source_ref": {"type": ["string", "null"]}
        }
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "actor", "action", "input_version", "output_version"],
        "properties": {
          "timestamp": {"type": "string", "format": "date-time"},
          "actor": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "input_version": {"type": "string", "minLength": 1},
          "output_version": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "default": []}
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_authorship_status", "ai_generated_material", "ownership_status", "voice_likeness_status", "cultural_review_status"],
      "properties": {
        "human_authorship_status": {"type": "string", "enum": ["documented", "partial", "unknown", "none_claimed"]},
        "ai_generated_material": {"type": "array", "items": {"type": "string"}},
        "ownership_status": {"type": "string", "enum": ["cleared", "partially_cleared", "unresolved", "not_applicable"]},
        "voice_likeness_status": {"type": "string", "enum": ["cleared", "review_required", "unresolved", "not_applicable"]},
        "cultural_review_status": {"type": "string", "enum": ["cleared", "review_required", "unresolved", "not_applicable"]},
        "limitations_or_exclusions": {"type": "array", "items": {"type": "string"}, "default": []}
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai_involvement_summary", "public_disclosure_status", "platform_metadata_status"],
      "properties": {
        "ai_involvement_summary": {"type": "string", "minLength": 1},
        "public_disclosure_status": {"type": "string", "enum": ["draft", "approved", "not_required", "unresolved"]},
        "platform_metadata_status": {"type": "string", "enum": ["prepared", "submitted", "not_applicable", "unresolved"]},
        "disclosure_ref": {"type": ["string", "null"]}
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approval_type", "status", "reviewer", "timestamp"],
        "properties": {
          "approval_type": {"type": "string", "enum": ["canon", "legal", "cultural", "release", "publication", "production"]},
          "status": {"type": "string", "enum": ["approved", "rejected", "pending", "not_required"]},
          "reviewer": {"type": "string", "minLength": 1},
          "timestamp": {"type": "string", "format": "date-time"},
          "notes": {"type": "string", "default": ""}
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "destinations", "release_date"],
      "properties": {
        "status": {"type": "string", "enum": ["unreleased", "scheduled", "released", "withdrawn", "blocked"]},
        "destinations": {"type": "array", "items": {"type": "string"}},
        "release_date": {"type": ["string", "null"], "format": "date-time"},
        "release_refs": {"type": "array", "items": {"type": "string"}, "default": []}
      }
    }
  }
}
